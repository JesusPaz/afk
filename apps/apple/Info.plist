<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>AFKRelayURL</key><string>$(AFK_RELAY_URL)</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>es</string></array>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>UTExportedTypeDeclarations</key><array><dict>
<key>UTTypeIdentifier</key><string>com.jesuspaz.afk.session</string>
<key>UTTypeConformsTo</key><array><string>public.data</string></array>
<key>UTTypeDescription</key><string>AFK Session</string>
</dict></array>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
<key>NSCameraUsageDescription</key><string>AFK uses the camera to scan the pairing QR on your Mac.</string>
<key>NSFaceIDUsageDescription</key><string>AFK verifies your identity before allowing access to your Mac terminal.</string>
<key>NSMicrophoneUsageDescription</key><string>AFK listens only while you dictate a command into your Mac terminal.</string>
<key>NSSpeechRecognitionUsageDescription</key><string>AFK turns your dictation into text for your Mac terminal, on the iPhone when the language allows it.</string>
<key>NSLocalNetworkUsageDescription</key><string>AFK connects to the relay you chose to share your Mac terminal.</string>
</dict></plist>
